# Production stack settings, read by docker-compose.yml.
# Copy to .env alongside the application variables before `docker compose up`.

# Postgres. The compose file refuses to start without this.
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_USER=ukweli
POSTGRES_DB=ukweli

# The hostname Caddy serves and obtains a certificate for.
# `localhost` issues a local certificate instead of contacting Let's Encrypt.
UKWELI_DOMAIN=localhost

# Must match the hostname above, because /r/{id} share links are built from it.
APP_URL=https://localhost
