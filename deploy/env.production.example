# Ukweli production configuration.
#
# This file is a template. The real /opt/ukweli/.env lives ONLY on the host and
# is never committed: a key in a git history is a key that has to be rotated.
# Copy this, fill it in over SSH, and keep it out of the repository.

# ── Required ─────────────────────────────────────────────────────────────

# Postgres runs as a container on this host, so this password protects a
# service reachable only from inside the compose network. Generate it anyway:
#   openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_USER=ukweli
POSTGRES_DB=ukweli

# The hostname Caddy serves and obtains a Let's Encrypt certificate for.
# A bare hostname triggers automatic HTTPS; `localhost` issues a local cert.
UKWELI_DOMAIN=www.ukweli.online

# The bare domain. Caddy redirects it to UKWELI_DOMAIN so the app has one
# canonical origin — two origins would mean two sets of share links and a
# session cookie that only works on one of them.
UKWELI_APEX=ukweli.online

# Must match the hostname above. Every /r/{id} share link is built from it, so
# a mismatch produces links that point somewhere nobody can reach.
APP_URL=https://www.ukweli.online

# ── Optional, but the product is diminished without them ─────────────────

# Without a key, seeded claims still work and free text returns a retryable
# 503. Use a production key, not the one on a developer's laptop.
ANTHROPIC_API_KEY=

# Per-IP limit on /api/analyze. Each analysis costs a model call.
RATE_LIMIT_ANALYZE_PER_MIN=10

# ── Auth ─────────────────────────────────────────────────────────────────

# false hides every auth route and treats each request as anonymous. Checking
# claims is unaffected — sign-in exists only to save history.
AUTH_ENABLED=false

# Required when AUTH_ENABLED=true. Signs sign-in tokens and session cookies:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Required when AUTH_ENABLED=true. Without it the app falls back to SMTP on
# localhost, where nothing is listening in production, so no link is ever
# delivered — the request still returns 202, by design.
RESEND_API_KEY=
