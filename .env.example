# ─────────────────────────────────────────────────────────────────────────────
# Ukweli environment configuration
# Copy to .env and fill in. Never commit .env — it is gitignored.
# No secret in this file may ever reach a client bundle; the web app reads
# nothing from here except what Vite exposes via VITE_* (currently: nothing).
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection used by the API and by EF Core migrations. Matches the
# credentials in docker-compose.dev.yml. Either form is accepted: this URL form,
# or a native Npgsql string (Host=...;Port=...;Database=...;Username=...;Password=...).
DATABASE_URL=postgres://ukweli:ukweli@localhost:5432/ukweli

# Anthropic API key, used only by the server for Phase 3 extract/verdict calls.
# Leave blank to run without AI: seeded claims keep working and free-text
# claims return 503. /healthz reports modelConfigured accordingly.
ANTHROPIC_API_KEY=

# Public base URL of the app. Used to build /r/<id> share links.
APP_URL=http://localhost:5173

# Auth (Phase 4). With AUTH_ENABLED=false every auth route is hidden and all
# requests are treated as anonymous; the whole demo still works.
AUTH_ENABLED=false
# Secret used to sign magic-link tokens and session cookies.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Magic-link delivery. In production set RESEND_API_KEY; in dev leave it blank
# and mail goes to Mailpit over SMTP (UI at http://localhost:8025).
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025

# Per-IP rate limit for POST /api/analyze, applied signed in or not.
RATE_LIMIT_ANALYZE_PER_MIN=10

# API server port.
PORT=8787
