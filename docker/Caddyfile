# Caddy obtains and renews certificates itself; there is nothing to configure
# beyond the hostnames.

# People type the bare domain. Sending them to the canonical host keeps one
# origin, which is what lets the session cookie be SameSite=Lax and removes
# CORS — and stops /r/{id} share links existing under two different addresses.
{$UKWELI_APEX} {
	redir https://{$UKWELI_DOMAIN}{uri} permanent
}

{$UKWELI_DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy api:8787
	}

	handle /healthz {
		reverse_proxy api:8787
	}

	handle {
		reverse_proxy web:80
	}

	header {
		# Ukweli shows quoted excerpts from elsewhere; it should never be
		# framed by another site, and its content type should not be guessed.
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
